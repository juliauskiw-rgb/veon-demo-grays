---
import Icon from "./Icon.astro";
import { phones, address } from "../data/club";
const lines = ["base-a", "base-b", "svc-a", "svc-b", "center", "side-1", "side-2", "single-1", "single-2"];
---
<section id="top" class="hero on-field" data-rec="U-R001,U-R010,M-R001" aria-labelledby="hero-title">
  <div class="container">
    <div class="court">
      {lines.map((l) => <span class={`ln ln-${l}`} aria-hidden="true"></span>)}
      <span class="ln ln-net" aria-hidden="true"></span>

      <h1 id="hero-title" class="hero__title">
Тенісні корти і&nbsp;дитяча <br class="t-break" />школа тенісу у&nbsp;Вишгороді
      </h1>

      <div class="path path--court">
        <div class="path__copy">
          <span class="path__name">Оренда корту</span>
          <span class="path__text">3 корти, хард CASALI, сертифікат ITF&nbsp;2. Від&nbsp;<span class="num">1950</span>&nbsp;грн/год.</span>
        </div>
        <div class="path__actions">
          <a class="btn btn--action" href={phones.tennis.tel}>Забронювати корт <Icon name="arrow" /></a>
          <a class="path__phone phone-line" href={phones.tennis.tel}>{phones.tennis.display}</a>
        </div>
      </div>

      <div class="slogan">Коли ми граємо — ми живемо</div>

      <div class="path path--school">
        <div class="path__copy">
          <span class="path__name">Школа тенісу</span>
          <span class="path__text">Діти від 4&nbsp;років і дорослі, ITF Play&amp;Stay. Перше заняття безкоштовне.</span>
        </div>
        <div class="path__actions">
          <a class="btn btn--light" href="#school"><span class="lbl-long">Безкоштовне пробне заняття</span><span class="lbl-short">Пробне заняття</span></a>
        </div>
      </div>

      <ul class="facts" role="list">
        <li>{address.street}, Вишгород</li>
        <li>Сауна для орендарів входить у вартість</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-4) var(--space-10); }
  .court {
    position: relative;
    display: grid;
    /* court standing up (390–1199): long axis runs down the page */
    grid-template-columns: 12px minmax(0, 1fr) 12px;
    grid-template-rows: auto auto var(--space-12) auto auto;
  }

  /* lines: 2px chalk, decorative grid items placed on the court's real lines */
  .ln { background: var(--color-chalk); pointer-events: none; z-index: 0; }
  .ln-net { background: var(--color-chalk); z-index: 1; }

  /* vertical court (default) */
  .ln-base-a  { grid-column: 1 / -1; grid-row: 1; align-self: start; height: var(--line); }
  .ln-base-b  { grid-column: 1 / -1; grid-row: 5; align-self: end; height: var(--line); }
  .ln-svc-a   { grid-column: 2; grid-row: 2; align-self: start; height: var(--line); }
  .ln-svc-b   { grid-column: 2; grid-row: 5; align-self: start; height: var(--line); }
  .ln-center  { display: none; }
  .ln-side-1  { grid-column: 1; grid-row: 1 / -1; justify-self: start; width: var(--line); }
  .ln-side-2  { grid-column: 3; grid-row: 1 / -1; justify-self: end; width: var(--line); }
  .ln-single-1 { grid-column: 2; grid-row: 1 / -1; justify-self: start; width: var(--line); }
  .ln-single-2 { grid-column: 2; grid-row: 1 / -1; justify-self: end; width: var(--line); }
  .ln-net     { grid-column: 1 / -1; grid-row: 3; align-self: center; height: var(--net); margin-inline: calc(-1 * var(--space-2)); }

  .hero__title, .path, .slogan, .facts { position: relative; z-index: 2; }
  .slogan { z-index: 3; }
  .hero__title {
    grid-column: 2; grid-row: 1;
    padding: var(--space-6) var(--space-4);
    font-size: var(--fs-h1); font-weight: 800; letter-spacing: -0.02em; line-height: 1.04;
    color: var(--color-chalk);
  }
  .t-break { display: none; }
  .path__copy { display: grid; gap: var(--space-2); }
  .path__name, .path__text { display: block; }
  .lbl-short { display: none; }
  @media (max-width: 379px) { .lbl-long { display: none; } .lbl-short { display: inline; } }
  .path { padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-3); align-content: start; }
  .path--court { grid-column: 2; grid-row: 2; }
  .path--school { grid-column: 2; grid-row: 4; }
  .path__name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lead); line-height: 1.2; }
  .path__text { color: var(--color-on-field-muted); max-width: 30rem; }
  .path__actions { display: grid; gap: var(--space-3); margin-top: var(--space-2); justify-items: start; }
  .path__actions .btn { width: 100%; padding-inline: var(--space-4); }
  .path__phone { display: none; color: var(--color-chalk); font-weight: 500; text-decoration: none; min-height: 44px; align-items: center; }
  .path__phone:hover { text-decoration: underline; }

  .slogan {
    grid-column: 2; grid-row: 3; justify-self: center; align-self: center;
    background: var(--color-field); padding: 0 var(--space-3);
    font-size: var(--fs-small); color: var(--color-on-field-muted); white-space: nowrap;
  }
  .facts {
    grid-column: 2; grid-row: 5; list-style: none;
    padding: var(--space-6) var(--space-4) var(--space-6);
    display: grid; gap: var(--space-1); font-size: var(--fs-small); color: var(--color-on-field-muted);
  }

  @media (min-width: 768px) {
    .path__phone { display: inline-flex; }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    .court { grid-template-columns: var(--space-10) minmax(0, 1fr) var(--space-10); }
    .path__actions { grid-auto-flow: column; align-items: center; justify-content: start; gap: var(--space-6); }
    .path__actions .btn { width: auto; }
    .t-break { display: inline; }
  }

  /* court lying down (1200+): real proportions 23.77 x 10.97 m, service lines 6.40 m from the net */
  @media (min-width: 1200px) {
    .hero { padding-block: var(--space-10); }
    .court {
      aspect-ratio: 2377 / 1097;
      grid-template-columns: minmax(0, 2308fr) minmax(0, 2692fr) 0px minmax(0, 2692fr) minmax(0, 2308fr);
      grid-template-rows: minmax(0, 1fr) minmax(0, 3fr) minmax(0, 3fr) minmax(0, 1fr);
    }
    .ln-base-a  { grid-column: 1; grid-row: 1 / -1; justify-self: start; align-self: stretch; width: var(--line); height: auto; }
    .ln-base-b  { grid-column: 5; grid-row: 1 / -1; justify-self: end; align-self: stretch; width: var(--line); height: auto; }
    .ln-svc-a   { grid-column: 2; grid-row: 2 / 4; justify-self: start; align-self: stretch; width: var(--line); height: auto; }
    .ln-svc-b   { grid-column: 5; grid-row: 2 / 4; justify-self: start; align-self: stretch; width: var(--line); height: auto; }
    .ln-center  { display: block; grid-column: 2 / 5; grid-row: 3; align-self: start; height: var(--line); }
    .ln-side-1  { grid-column: 1 / -1; grid-row: 1; justify-self: stretch; align-self: start; width: auto; height: var(--line); }
    .ln-side-2  { grid-column: 1 / -1; grid-row: 4; justify-self: stretch; align-self: end; width: auto; height: var(--line); }
    .ln-single-1 { grid-column: 1 / -1; grid-row: 2; justify-self: stretch; align-self: start; width: auto; height: var(--line); }
    .ln-single-2 { grid-column: 1 / -1; grid-row: 4; justify-self: stretch; align-self: start; width: auto; height: var(--line); }
    .ln-net     { grid-column: 3; grid-row: 1 / -1; justify-self: center; align-self: stretch; width: var(--net); height: auto; margin: calc(-1 * var(--space-4)) 0; }

    .hero__title { grid-column: 1 / -1; grid-row: 2; align-self: center; padding: 0 var(--space-10); }
    .t-break { display: inline; }
    .path { padding: var(--space-4) var(--space-6) 0; align-self: start; gap: var(--space-2); }
    .path--court { grid-column: 2; grid-row: 3; }
    .path--school { grid-column: 4; grid-row: 3; padding-left: var(--space-12); padding-right: var(--space-4); }
    .path__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-4); margin-top: var(--space-1); }
    .path__phone { min-height: 32px; }
    .path__actions .btn { width: auto; }
    .slogan {
      grid-column: 3; grid-row: 3; justify-self: start; align-self: center;
      writing-mode: vertical-rl; transform: rotate(180deg);
      background: transparent; padding: 0; margin-left: var(--space-4);
    }
    .facts { grid-column: 5; grid-row: 3; align-self: end; padding: var(--space-6); }
  }

  /* motion 1: the court lines are drawn from the net outwards; text and buttons are there from the start */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ln { animation: draw-y var(--dur-line) var(--ease-out) both; }
    :global(.js) .ln-base-a, :global(.js) .ln-base-b, :global(.js) .ln-svc-a, :global(.js) .ln-svc-b, :global(.js) .ln-net { animation-name: draw-x; }
    :global(.js) .ln-net { animation-duration: 500ms; }
    @media (min-width: 1200px) {
      :global(.js) .ln { animation-name: draw-x; }
      :global(.js) .ln-base-a, :global(.js) .ln-base-b, :global(.js) .ln-svc-a, :global(.js) .ln-svc-b, :global(.js) .ln-net { animation-name: draw-y; }
    }
    @media (max-width: 767px) {
      :global(.js) .ln { animation-duration: 500ms; }
    }
  }
  /* once drawn, the animation is removed so later re-styles (resize, print, capture) never replay it */
  :global(.js) .court.is-drawn .ln { animation: none; }
  @keyframes draw-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes draw-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
</style>

<script>
  const court = document.querySelector<HTMLElement>(".hero .court");
  if (court) {
    const done = () => court.classList.add("is-drawn");
    window.setTimeout(done, 1000); // longest line animation is 700 ms
  }
</script>
