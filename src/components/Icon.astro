---
// Small line icons drawn for this site (stroke = currentColor). Decorative only.
interface Props { name: "arrow" | "phone" | "mail" | "map" | "menu" | "close"; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
  {name === "arrow" && <path d="M4 12h15M14 6l6 6-6 6" />}
  {name === "phone" && <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" stroke-linecap="round" stroke-linejoin="round" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" /><path d="M3 6l9 7 9-7" /></>}
  {name === "map" && <><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === "menu" && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === "close" && <path d="M5 5l14 14M19 5L5 19" />}
</svg>
