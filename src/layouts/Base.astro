---
import "@fontsource-variable/geologica/wght.css";
import "@fontsource-variable/golos-text/wght.css";
import "../styles/tokens.css";
import "../styles/global.css";
import geologicaCyr from "@fontsource-variable/geologica/files/geologica-cyrillic-wght-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={geologicaCyr} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

<style is:global>
  /* repeated here so the layout carries the Floor rule next to its markup (global.css has the same) */
  html, body { overflow-x: clip; }
</style>
