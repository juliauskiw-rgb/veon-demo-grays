---
import Icon from "./Icon.astro";
import { phones, email, mailto, address, mapUrl, hours, socials } from "../data/club";
const others = [phones.fitness, phones.fitnessDesk, phones.restaurant];
---
<section id="contacts" class="section contacts on-field" aria-labelledby="contacts-title">
  <div class="container">
    <span class="baseline" data-reveal="line" aria-hidden="true"></span>
    <h2 id="contacts-title" class="contacts__title">Контакти і графік роботи</h2>

    <div class="contacts__grid">
      <div class="where">
        <address class="where__addr">
          <span class="where__street">{address.street}</span>
          <span class="where__city">{address.city}</span>
        </address>
        <a class="where__map" href={mapUrl} rel="noopener" target="_blank"><Icon name="map" /> Відкрити на карті</a>

        <h3 class="mini">Графік роботи клубу</h3>
        <dl class="hours">
          {hours.map((h) => <div><dt>{h.days}</dt><dd class="num">{h.time}</dd></div>)}
        </dl>
      </div>

      <div class="call">
        <p class="call__label">{phones.tennis.label}</p>
        <a class="call__phone phone-line" href={phones.tennis.tel}>{phones.tennis.display}</a>
        <a class="btn btn--action" href={phones.tennis.tel}>Забронювати корт <Icon name="arrow" /></a>

        <ul class="phones" role="list">
          {others.map((p) => (
            <li><span class="phones__label">{p.label}</span><a class="phone-line" href={p.tel}>{p.display}</a></li>
          ))}
          <li><span class="phones__label">E-mail</span><a href={mailto("Питання до клубу")}>{email}</a></li>
        </ul>

        <ul class="socials" role="list">
          {socials.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank">{s.name} <span class="socials__handle">{s.handle}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts { padding-block: var(--section-pad); }
  .contacts .baseline { color: var(--color-chalk); }
  .contacts__title { margin-bottom: var(--space-10); }
  .contacts__grid { display: grid; gap: var(--space-16); }
  .where__addr { font-style: normal; display: grid; gap: var(--space-1); }
  .where__street { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; }
  .where__city { font-size: var(--fs-lead); color: var(--color-on-field-muted); }
  .where__map { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; margin-top: var(--space-3); font-weight: 600; }
  .where__map :global(svg), .socials :global(svg) { width: 20px; height: 20px; }
  .mini { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; margin: var(--space-10) 0 var(--space-3); }
  .hours { margin: 0; display: grid; }
  .hours div { display: flex; justify-content: space-between; gap: var(--space-6); padding-block: var(--space-3); border-top: 1px solid var(--color-field-line); max-width: 24rem; font-size: var(--fs-lead); }
  .hours div:last-child { border-bottom: 1px solid var(--color-field-line); }
  .hours dd { margin: 0; font-weight: 600; }

  .call { display: grid; gap: var(--space-3); align-content: start; justify-items: start; }
  .call__label { color: var(--color-on-field-muted); }
  .call__phone { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.1; text-decoration: none; }
  .call__phone:hover { text-decoration: underline; }
  .call .btn { margin-top: var(--space-2); }
  .phones { list-style: none; display: grid; width: 100%; margin-top: var(--space-10); }
  .phones li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-1) var(--space-6); padding-block: var(--space-3); border-top: 1px solid var(--color-field-line); }
  .phones li:last-child { border-bottom: 1px solid var(--color-field-line); }
  .phones__label { color: var(--color-on-field-muted); }
  .phones a { font-weight: 600; overflow-wrap: anywhere; }
  .socials { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-4); }
  .socials a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; font-weight: 600; }
  .socials__handle { font-weight: 400; color: var(--color-on-field-muted); }

  @media (min-width: 1024px) {
    .contacts__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); column-gap: var(--gap); }
  }
</style>
